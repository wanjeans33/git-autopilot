{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__HOOKS_DIR__/guard-branch.py\"",
            "timeout": 10,
            "statusMessage": "检查分支"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__HOOKS_DIR__/nudge-review.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
