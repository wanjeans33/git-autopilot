{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__HOOKS_DIR__/guard-branch.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__HOOKS_DIR__/wrap-up.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
