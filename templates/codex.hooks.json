{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|local_shell|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON__\" \"__HOOKS_DIR__/guard-branch.py\"",
            "statusMessage": "检查分支"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON__\" \"__HOOKS_DIR__/wrap-up.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
