{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" guard-branch.py --host claude",
            "timeout": 10,
            "statusMessage": "检查分支"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" wrap-up.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
